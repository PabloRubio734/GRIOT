# Plantilla de variables de entorno de GRIOT.
# Copia este archivo como .env.local EN LA RAÍZ DEL PROYECTO (Git lo ignora)
# y rellena los valores. NO subas nunca una clave real al repositorio.

# --- Conexión con Claude (obligatorio) ---
# Clave de la API de Anthropic. Solo la lee el servidor; nunca llega al navegador.
ANTHROPIC_API_KEY=
# Modelo de Claude. Verificado con la API de modelos: Claude Haiku 5.5.
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Modo demostración (opcional) ---
# true = respuestas simuladas con plantillas, sin llamar a Claude.
# Se indican siempre como «Respuesta de demostración» en la interfaz.
GRIOT_DEMO_MODE=false

# --- Control de consumo (opcional; estos son los valores por defecto) ---
# Esfuerzo de razonamiento: low | medium | high (low gasta menos tokens).
ANTHROPIC_EFFORT=low
# Tokens máximos de salida por respuesta (incluye el razonamiento interno).
GRIOT_MAX_OUTPUT_TOKENS=1500
# Mensajes recientes y caracteres totales del historial que se envían a Claude.
GRIOT_MAX_HISTORY_MESSAGES=12
GRIOT_MAX_HISTORY_CHARS=16000
# Límite de solicitudes: por minuto y cliente, y por día para todo el servidor.
GRIOT_RATE_LIMIT_PER_MINUTE=8
GRIOT_RATE_LIMIT_PER_DAY=150
